# Deployment variables for docker-compose.yml and the optional Compose files.
# Run `bash install.sh` to generate `.env` and deploy. The installer preserves
# existing settings. Middleware passwords are supplied through protected files.
# Compose reads only `.env`; it does not load this template itself.
# Image addresses are defined here; Compose requires them from `.env`.
# Container-internal addresses and derived environment values are wired in
# docker-compose.yml.

# Public account for the default registry; install.sh logs in before pulling.
CR_REGISTRY_USERNAME=docker
CR_REGISTRY_PASSWORD=dataelem

# Images: use complete references, including registry/repository and tag or digest.
# Backend and worker share one image; OpenFGA and its migration share another.
# CR release tags below are AMD64; on ARM64 append -arm64 to the five BISHENG service image tags.
# Tag builds publish -amd64/-arm64 first; the formal tags are promoted after Release approval.
BISHENG_BACKEND_IMAGE=cr.dataelem.com/dataelement/bisheng-backend:v3.1.0-beta2
BISHENG_FRONTEND_IMAGE=cr.dataelem.com/dataelement/bisheng-frontend:v3.1.0-beta2
# always: refresh published tags; missing: use cached images (also supports local acceptance builds).
BISHENG_IMAGE_PULL_POLICY=always
MYSQL_IMAGE=cr.dataelem.com/mysql:8.0
OPENFGA_IMAGE=cr.dataelem.com/dataelement/openfga:v1.15.2-dm
REDIS_IMAGE=cr.dataelem.com/redis:7.0.4
ELASTICSEARCH_IMAGE=cr.dataelem.com/bitnami/elasticsearch:8.12.0
ETCD_IMAGE=cr.dataelem.com/quay.io/coreos/etcd:v3.5.5
MINIO_IMAGE=cr.dataelem.com/minio/minio:RELEASE.2023-03-20T20-16-18Z
MILVUS_IMAGE=cr.dataelem.com/milvusdb/milvus:v2.5.10
# Full image reference replaces the former SANDBOX_IMAGE_TAG setting.
BISHENG_SANDBOX_IMAGE=cr.dataelem.com/dataelement/bisheng-sandbox:v3.1.0-beta2
# Optional FT profile: historical FT version, independent of platform tags.
BISHENG_FT_IMAGE=cr.dataelem.com/dataelement/bisheng-ft:v0.5.0
BISHENG_FT_PORT=8000
# Optional app-runtime profile images.
BISHENG_RUNTIME_MANAGER_IMAGE=cr.dataelem.com/dataelement/bisheng-runtime-manager:v3.1.0-beta2
BISHENG_APP_PROXY_IMAGE=cr.dataelem.com/dataelement/bisheng-app-proxy:v3.1.0-beta2
# Socket proxy uses separate architecture tags; the unsuffixed tag is AMD64.
DOCKER_SOCKET_PROXY_IMAGE=cr.dataelem.com/tecnativa/docker-socket-proxy:0.3.0
# ARM alternative: set DOCKER_SOCKET_PROXY_IMAGE to cr.dataelem.com/tecnativa/docker-socket-proxy:0.3.0-arm64.
# Optional standalone Compose services.
ONLYOFFICE_IMAGE=cr.dataelem.com/onlyoffice/documentserver:7.1.1
# Gateway version is independent of the BiSheng version.
BISHENG_GATEWAY_IMAGE=cr.dataelem.com/dataelement/gateway:v1.9.3
# ARM hosts: set BISHENG_GATEWAY_IMAGE to a verified compatible ARM or multi-architecture image.

# The dedicated platform network is created automatically by Compose.
COMPOSE_PROJECT_NAME=bisheng
BISHENG_NETWORK_NAME=bisheng-network

# install.sh adds/removes gateway and ft here; Compose selects optional services.
COMPOSE_PROFILES=app-runtime
BISHENG_PRO=false
BISHENG_PUBLIC_URL=
# User-supplied readable license file; no file means no Gateway.
BISHENG_GATEWAY_LICENSE_FILE=
# Populated from the file by install.sh, never entered directly.
BISHENG_GATEWAY_LICENSE=
BISHENG_GATEWAY_HMAC_SECRET=
BISHENG_GATEWAY_DB_PASSWORD=
# install.sh selects a generated directory when Gateway is enabled.
BISHENG_NGINX_CONF_DIR=./nginx/conf.d

# Credential-enabled backend image is required; old images cannot read this bundle.
# Managed automatically by install.sh. Operators need not fill these paths.
# Optional for non-interactive automation; interactive installs ask for missing passwords.
BISHENG_CREDENTIAL_INPUTS_FILE=
BISHENG_CREDENTIALS_DIR=
BISHENG_SECRET_KEYS_FILE=
BISHENG_SECRET_FILE_GID=
BISHENG_CREDENTIAL_REVISION=
# Existing single-node deployment uses HTTP. TLS deployments must explicitly
# enable REST/transport TLS and provide matching certificates in an override.
BISHENG_ES_REST_TLS=false
BISHENG_ES_SKIP_TRANSPORT_TLS=yes

# Base services
# Where the compose stack keeps its data directories. Defaults to the compose
# file's own directory.
DOCKER_VOLUME_DIRECTORY=.
# Internal service ports are localhost-only by default. Remote maintenance must
# use an explicit protected bind/ingress, firewall and TLS; Docker DNS is unchanged.
BISHENG_MIDDLEWARE_BIND_IP=127.0.0.1
# Presigned document links/OnlyOffice may need a separately protected public MinIO
# ingress. Set this explicit address only after configuring sharepoint/TLS/firewall.
BISHENG_MINIO_BIND_IP=127.0.0.1
# Maximum OpenFGA authorization graph resolution depth.
OPENFGA_RESOLVE_NODE_LIMIT=25

# Topology !env bindings from docker/bisheng/config/config.yaml.
# install.sh also adds any missing !env keys; leave these non-empty — an empty
# BS_ELASTICSEARCH_SSL_VERIFY makes prepare fail with "ssl_verify: invalid object".
# MinIO access/secret keys are filled from the interactive password prompts / inputs.
BS_ELASTICSEARCH_URL=http://elasticsearch:9200
BS_ELASTICSEARCH_SSL_VERIFY={}
BS_MILVUS_CONNECTION_ARGS={"host":"milvus","port":"19530","user":"","password":"","secure":false}
BS_MILVUS_IS_PARTITION=true
BS_MILVUS_PARTITION_SUFFIX=1
BS_MINIO_SCHEMA=false
BS_MINIO_CERT_CHECK=false
BS_MINIO_ENDPOINT=minio:9000
BS_MINIO_SHAREPOINT=minio:9000


# Code sandbox
# Shared by backend, worker and code runners. install.sh generates 32 random
# bytes and preserves a configured strong token. Direct Compose requires it.
SANDBOX_TOKEN=
# Local code execution (code nodes, code interpreter type `local`) runs under a
# throwaway uid with resource limits. Startup tightens /app/bisheng and
# /app/data (host data/bisheng) to 0700. Set to `off` to keep the old
# same-user execution.
LOCAL_ISOLATION=uid

# CPUs shared by all sessions on each code runner (code-runner-1/2). Must be
# <= the host CPU count or Docker refuses to start the runners. Default 2.
SANDBOX_CPUS=2

# App runtime is enabled in new deployments; existing .env choices are preserved.
# Configure host isolation before running hosted applications. See docs/architecture/14-app-factory-deployment.md
# and src/runtime-manager/OPERATIONS.md for the deployment prerequisites.
BISHENG_APP_DATA_ROOT=/opt/bisheng/app-data
BISHENG_RUNTIME_PROTOCOL_VERSION=2
BISHENG_RUNTIME_NODE_ID=docker-node-1
BISHENG_RUNTIME_OFFLINE=false
BISHENG_RUNTIME_IMAGE_PULL_POLICY=never
BISHENG_RUNTIME_TASK_TIMEOUT_SECONDS=1800
# Optional audit source DateTime zone; blank uses the backend/worker TZ (then UTC).
BISHENG_RUNTIME_AUDIT_SOURCE_TIMEZONE=

# App runtime authentication: generate a distinct secret for each variable,
# e.g. openssl rand -hex 32. Required when enabling the app-runtime profile.
# Keep real secrets out of Git and retain a secure backup.
BISHENG_RUNTIME_MANAGER_SECRET=
BISHENG_RUNTIME_CONTROL_SECRET=
BISHENG_RUNTIME_ENTRY_SECRET=
BISHENG_RUNTIME_EGRESS_SECRET=
BISHENG_APP_PROXY_HMAC_SECRET=
BISHENG_APP_OBO_SECRET=
# Fernet key, generated with cryptography. Shared by backend and worker only.
# Generate in the backend Python environment:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
BISHENG_RUNTIME_PAYLOAD_KEY=

# App runtime host isolation: independent Docker-host reporter identity.
# Generate the node descriptor with --describe and install host units before
# enabling app runtime; see deploy/runtime-manager/README.md.
BISHENG_RUNTIME_HOST_ISOLATION_SECRET=
BISHENG_RUNTIME_HOST_ISOLATION_NODES=

# App runtime capacity and build package indexes
BISHENG_RTM_RESERVE_MB=2048
BISHENG_RTM_OVERCOMMIT_RATIO=0.8
BISHENG_RTM_BUILD_RESERVE_MB=2048
# Python dependencies are downloaded only during the isolated preparation phase.
# Production private deployments may replace this with an approved internal mirror.
BISHENG_RTM_BUILD_INDEX_URL=https://pypi.org/simple
# npm download source for the isolated preparation phase.
# Replace it with an approved enterprise mirror when needed.
BISHENG_RTM_BUILD_NPM_REGISTRY=https://registry.npmjs.org
# Runtime/preparer base images are selected by immutable profiles in backend,
# not by RTM_IMAGE_PREFIX. See src/runtime-manager/OPERATIONS.md.
