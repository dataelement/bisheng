{
  "openapi": "3.0.3",
  "info": {
    "title": "采购历史Excel样例查询",
    "version": "1.0.0",
    "description": "只读查询授权样例。导入前阅读同目录platform-import.md；访问令牌通过受控执行器获取，不作为模型参数。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18768",
      "description": "119本人采购Mock伴随服务"
    }
  ],
  "paths": {
    "/openapi/tic-definition/integrationInterface/call": {
      "post": {
        "operationId": "query_procurement_history",
        "summary": "按型号查询采购历史Excel样例",
        "description": "查询已授权Excel样例的采购历史，不是客户生产数据。requestQuery必须为对象，model必填、1—256字符；match_mode为exact或regex，默认exact；pageNum默认1且最大100000；pageSize默认50且最大100。响应列表位于data.data.result，空结果仍是成功；失败不得视为空历史。比较前须取完所有分页并核对snapshotId/fieldMap/sourceRows/totalElements，不能只取第一页推荐。",
        "parameters": [
          {
            "name": "functionCode",
            "in": "query",
            "required": true,
            "description": "固定mock函数；平台v3.0.0导入后需按适配说明固化到子工具extra.path。",
            "schema": {
              "type": "string",
              "enum": [
                "mock_procurement_history_v1"
              ],
              "default": "mock_procurement_history_v1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requestQuery": {
                    "type": "object",
                    "properties": {
                      "model": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "description": "规格型号；exact按NFKC、空白、大小写归一后精确匹配，regex按Python re忽略大小写fullmatch。"
                      },
                      "match_mode": {
                        "type": "string",
                        "enum": [
                          "exact",
                          "regex"
                        ],
                        "default": "exact"
                      },
                      "pageNum": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000,
                        "default": 1,
                        "description": "从1开始；接口也兼容正整数字符串，工具使用整数。"
                      },
                      "pageSize": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100,
                        "default": 50,
                        "description": "每页条数；工具使用整数。"
                      }
                    },
                    "required": [
                      "model"
                    ],
                    "additionalProperties": false,
                    "description": "查询已授权Excel样例的采购历史，不是客户生产数据。requestQuery必须为对象，model必填、1—256字符；match_mode为exact或regex，默认exact；pageNum默认1且最大100000；pageSize默认50且最大100。响应列表位于data.data.result，空结果仍是成功；失败不得视为空历史。比较前须取完所有分页并核对snapshotId/fieldMap/sourceRows/totalElements，不能只取第一页推荐。"
                  }
                },
                "required": [
                  "requestQuery"
                ],
                "additionalProperties": false
              },
              "example": {
                "requestQuery": {
                  "model": "BMS10-146 TYPE I",
                  "match_mode": "exact",
                  "pageNum": 1,
                  "pageSize": 50
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功；无历史时result为空且totalElements为0。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistorySuccess"
                }
              }
            }
          },
          "400": {
            "description": "无效JSON、参数或正则",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryError"
                }
              }
            }
          },
          "401": {
            "description": "缺少、失效或无效访问令牌",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryError"
                }
              }
            }
          },
          "404": {
            "description": "未知接口或functionCode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryError"
                }
              }
            }
          },
          "413": {
            "description": "请求体超过16384字节或长度无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryError"
                }
              }
            }
          },
          "415": {
            "description": "请求Content-Type不是application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryError"
                }
              }
            }
          },
          "422": {
            "description": "正则超过一秒预算",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryError"
                }
              }
            }
          },
          "429": {
            "description": "服务并发预算达到上限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryError"
                }
              }
            }
          },
          "500": {
            "description": "服务内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryError"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    }
  },
