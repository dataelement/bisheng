{
  "name": "bisheng-frontend",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:client": "pnpm --filter bishengchat dev",
    "dev:platform": "pnpm --filter bisheng dev",
    "dev:ui": "pnpm --filter bishengchat dev:docs",
    "build:client": "pnpm --filter bishengchat build",
    "build:platform": "pnpm --filter bisheng build",
    "build": "pnpm --filter bisheng build && pnpm --filter bishengchat build",
    "build:docs": "pnpm --filter bishengchat build:docs",
    "lint": "pnpm --filter bisheng lint && pnpm --filter bishengchat lint && pnpm --filter @bisheng/ui lint && pnpm --filter @bisheng/file-viewers lint && pnpm --filter @bisheng/chat lint && pnpm --filter @bisheng/api-client lint",
    "typecheck": "pnpm --filter bisheng typecheck && pnpm --filter bishengchat typecheck && pnpm --filter @bisheng/file-viewers typecheck && pnpm --filter @bisheng/chat typecheck && pnpm --filter @bisheng/api-client typecheck",
    "locales:build": "pnpm --filter @bisheng/locales build",
    "locales:watch": "pnpm --filter @bisheng/locales watch",
    "locales:check": "pnpm --filter @bisheng/locales check",
    "check-i18n": "node scripts/check-i18n.mjs",
    "preinstall": "npx only-allow pnpm",
    "test:config": "vitest run --config config/vitest.config.mts --maxWorkers=1 --minWorkers=1",
    "typecheck:config": "tsc -p config/tsconfig.json"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@0.8.13": "0.8.15",
      "@xmldom/xmldom@0.9.10": "0.9.12",
      "brace-expansion@1.1.16": "1.1.18",
      "brace-expansion@2.1.2": "2.1.4",
      "js-yaml@4.3.0": "4.3.2",
      "dompurify@3.4.12": "3.4.13",
      "prismjs@1.27.0": "1.30.0",
      "js-yaml@3.15.0": "3.15.2",
      "brace-expansion@5.0.7": "5.0.9",
      "fast-uri@3.1.4": "3.1.6",
      "qs@6.15.3": "6.16.0",
      "nanoid@3.3.16": "3.3.18",
      "rollup@^4.0.0": "4.64.12",
      "postcss@^8.0.0": "8.5.31",
      "xlsx": "file:vendor/xlsx-0.20.3.tgz"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^17.7.0",
    "typescript-eslint": "^8",
    "typescript-strict-plugin": "^2.4.4",
    "vite": "catalog:",
    "typescript": "catalog:",
    "tailwindcss": "catalog:",
    "postcss": "catalog:",
    "autoprefixer": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.15.9 <10"
  }
}
