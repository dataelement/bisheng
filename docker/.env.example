# Copy to `.env` next to docker-compose.yml and fill in before the first start.
# Compose reads it automatically; `docker compose up` refuses to start while a
# required value is missing, which is deliberate -- a shipped default password
# is the same password on every installation.

# Object storage credentials. Used by MinIO itself, by the bisheng backend and
# workers, and by Milvus, which stores its segments in the same bucket. All of
# them must agree, so they are defined once here.
# Generate: openssl rand -hex 16
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Where the compose stack keeps its data directories. Defaults to the compose
# file's own directory.
# DOCKER_VOLUME_DIRECTORY=.

# Local code execution (code nodes, code interpreter type `local`) runs under a
# throwaway uid with resource limits. Startup tightens /app/bisheng and
# /app/data (host data/bisheng) to 0700. Set to `off` to keep the old
# same-user execution.
# LOCAL_ISOLATION=uid


# Optional app-runtime profile (F086). Distinct random HMAC secrets, e.g.
# openssl rand -hex 32. Keep these values out of Git and retain a secure backup.
BISHENG_RUNTIME_MANAGER_SECRET=
BISHENG_RUNTIME_CONTROL_SECRET=
BISHENG_RUNTIME_ENTRY_SECRET=
BISHENG_RUNTIME_EGRESS_SECRET=
BISHENG_APP_PROXY_HMAC_SECRET=
BISHENG_APP_OBO_SECRET=
# Fernet key, generated with cryptography. Shared by backend and worker only.
BISHENG_RUNTIME_PAYLOAD_KEY=
# BISHENG_RUNTIME_MANAGER_IMAGE=dataelement/bisheng-runtime-manager:<validated-release>
# BISHENG_APP_PROXY_IMAGE=dataelement/bisheng-app-proxy:<validated-release>
# BISHENG_APP_DATA_ROOT=/opt/bisheng/app-data
# BISHENG_RUNTIME_NODE_ID=docker-node-1
# BISHENG_RUNTIME_OFFLINE=true
# BISHENG_RUNTIME_IMAGE_PULL_POLICY=never
# BISHENG_RTM_BUILD_INDEX_URL=https://approved-python-mirror.example/simple
# BISHENG_RTM_BUILD_NPM_REGISTRY=https://approved-npm-mirror.example
# Runtime/preparer base images are selected by immutable profiles in backend,
# not by RTM_IMAGE_PREFIX. See src/runtime-manager/OPERATIONS.md.

# F054: independent Docker-host reporter identity (not the manager identity).
# Generate the node descriptor with --describe; install host units before new deployments.
BISHENG_RUNTIME_HOST_ISOLATION_SECRET=
BISHENG_RUNTIME_HOST_ISOLATION_NODES=

# Optional audit source DateTime zone; blank uses the backend/worker TZ (then UTC).
BISHENG_RUNTIME_AUDIT_SOURCE_TIMEZONE=
