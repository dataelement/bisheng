{
  "name": "@bisheng/file-viewers",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-app document preview components (source-shipped; consumed via workspace:*). Copy lives in @bisheng/locales shared domain (namespace shared:).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./html": "./src/html/sandboxedHtml.ts",
    "./resource": "./src/usePreviewResource.ts",
    "./types": "./src/types.ts",
    "./docx": "./src/viewers/DocxViewer.tsx",
    "./text": "./src/viewers/TextViewer.tsx",
    "./markdown": "./src/viewers/MarkdownViewer.tsx",
    "./html-viewer": "./src/viewers/HtmlViewer.tsx",
    "./image": "./src/viewers/ImageViewer.tsx",
    "./media": "./src/viewers/MediaViewer.tsx",
    "./media-player": "./src/viewers/MediaPlayer.tsx",
    "./transcript": "./src/viewers/MediaTranscriptTabs.tsx",
    "./locale": "./src/usePreviewLocale.ts",
    "./viewer-types": "./src/viewerTypes.ts",
    "./sanitize": "./src/html/sanitizeHtml.ts",
    "./formats": "./src/formats.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --minWorkers=1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-i18next": ">=13"
  },
  "dependencies": {
    "xlsx": "catalog:",
    "xlsx-populate": "^1.21.0",
    "mammoth": "1.12.0",
    "dompurify": "catalog:",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "rehype-highlight": "^6.0.0",
    "bisheng-icons": "catalog:",
    "@bisheng/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@testing-library/react": "^16.0.0",
    "@types/react-dom": "catalog:",
    "react-dom": "^18.2.0",
    "jsdom": "^25.0.0"
  }
}
