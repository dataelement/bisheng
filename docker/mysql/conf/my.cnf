[client]
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4

[mysqld]
max_connections=1000
# `SET NAMES x` resets collation_connection to x's DEFAULT collation, so the
# collation must be set as part of the NAMES statement — setting it first and
# running `NAMES utf8mb4` afterwards silently undid it.
init_connect='SET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci'
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
# Required, not optional: init_connect is SKIPPED for users holding SUPER /
# CONNECTION_ADMIN, and BiSheng connects as root. Without this the connection
# keeps utf8mb4_0900_ai_ci (MySQL 8's default for utf8mb4) while every table is
# utf8mb4_unicode_ci, and any comparison between a CAST/literal and a VARCHAR
# column fails with `1267 Illegal mix of collations`.
skip-character-set-client-handshake
sql_mode=STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
