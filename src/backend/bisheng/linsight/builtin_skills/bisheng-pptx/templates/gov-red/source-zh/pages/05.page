      - 249
      - 41
    - - '2024'
      - 258
      - 62
    - - '2025'
      - 268
      - 87.6
    - - '2026'
      - 276
      - 110.2
  series:
  - type: bar
    name: 传统业务
    encode:
      x: year
      y: base
    fill: $red
    dataLabels:
      show: false
  - type: bar
    name: 新兴业务
    encode:
      x: year
      y: new
    fill: $gold
    dataLabels:
      show: false
  xAxis:
    label:
      fontSize: 11
      color: $muted
    gridLine: false
  yAxis:
    min: 0
    label:
      fontSize: 10
      color: $muted
    gridLine:
      color: $rule
      style: dot
  legend:
    show: true
    position: top
    fontSize: 11
  fontFamily:
    latin: Arial
    ea: Microsoft YaHei
  fill:
    type: solid
    color: '#FFFFFF00'
  border:
