{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform",
    "services",
    "execution",
    "images",
    "network",
    "storage",
    "admission",
    "offline"
  ],
  "properties": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "backendBase",
        "caConfigMap"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "pattern": "^https://[^/]+/?$"
        },
        "backendBase": {
          "type": "string",
          "pattern": "^https?://[^/]+/?$"
        },
        "caConfigMap": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "credentialsSecret",
        "materialIssuerSecret",
        "admissionTlsSecret",
        "managerAccount",
        "managerReplicas",
        "entryReplicas",
        "egressReplicas",
        "admissionReplicas",
        "managerType",
        "entryType",
        "managerNodePort",
        "entryNodePort",
        "egressClusterIP",
        "pullSecret"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "allOf": [
            {
              "not": {
                "enum": [
                  "default",
                  "kubekey-system"
                ]
              }
            },
            {
              "not": {
                "pattern": "^kube-"
              }
            }
          ]
        },
        "credentialsSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "materialIssuerSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "admissionTlsSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "managerAccount": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "managerReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "entryReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "egressReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "admissionReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "managerType": {
          "enum": [
            "ClusterIP",
            "NodePort"
          ]
        },
        "entryType": {
          "enum": [
            "ClusterIP",
            "NodePort"
          ]
        },
        "managerNodePort": {
          "type": "integer",
          "minimum": 30000,
          "maximum": 32767
        },
        "entryNodePort": {
          "type": "integer",
          "minimum": 30000,
          "maximum": 32767
        },
        "egressClusterIP": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-fA-F.:]+$"
        },
        "pullSecret": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "clusterId",
        "nodeId",
        "installationId",
        "architecture",
        "memoryBudgetMi",
        "cpuBudgetMillicores",
        "maxPods",
        "temporaryStorageMi",
        "runtimeClass",
        "statusPolicyRevision",
        "cniUsername",
        "pullSecret",
        "dataKeyConfigMap",
        "dataPublicKeys",
        "probeReport",
        "canaryPlans",
        "canaryProfiles",
        "sandbox",
        "runtimeClasses"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "allOf": [
            {
              "not": {
                "enum": [
                  "default",
                  "kubekey-system"
                ]
              }
            },
            {
              "not": {
                "pattern": "^kube-"
              }
            }
          ]
        },
        "clusterId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "nodeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "installationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "architecture": {
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "memoryBudgetMi": {
          "type": "integer",
          "minimum": 1
        },
        "cpuBudgetMillicores": {
          "type": "integer",
          "minimum": 1
        },
        "maxPods": {
          "type": "integer",
          "minimum": 1
        },
        "temporaryStorageMi": {
          "type": "integer",
          "minimum": 1
        },
        "runtimeClass": {
          "type": "string"
        },
        "statusPolicyRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "cniUsername": {
          "type": "string"
        },
        "pullSecret": {
          "type": "string"
        },
        "dataKeyConfigMap": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "dataPublicKeys": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "probeReport": {
          "type": "object"
        },
        "canaryPlans": {
          "type": "object"
        },
        "canaryProfiles": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "runtime_image",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
              },
              "runtime_image": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
              },
              "command": {
                "enum": [
                  [
                    "python",
                    "--version"
                  ],
                  [
                    "node",
                    "--version"
                  ],
                  [
                    "nginx",
                    "-v"
                  ]
                ]
              }
            }
          }
        },
        "sandbox": {
          "enum": [
            "default",
            "recommended",
            "hardened"
          ]
        },
        "runtimeClasses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recommended",
            "hardened"
          ],
          "properties": {
            "recommended": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
            },
            "hardened": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
            }
          }
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manager",
        "entry",
        "egress",
        "admission",
        "helper",
        "assembler"
      ],
      "properties": {
        "manager": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
        },
        "entry": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
        },
        "egress": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
        },
        "admission": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
        },
        "helper": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
        },
        "assembler": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
            },
            {
              "const": ""
            }
          ]
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "podCidrs",
        "serviceCidrs",
        "controlAllowedCidrs",
        "entryAllowedCidrs",
        "kubernetesApiCidrs",
        "dnsCidrs",
        "backendCidrs",
        "backendPorts",
        "egressPorts",
        "apiServer"
      ],
      "properties": {
        "podCidrs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$"
          }
        },
        "serviceCidrs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$"
          }
        },
        "controlAllowedCidrs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$"
          }
        },
        "entryAllowedCidrs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$"
          }
        },
        "kubernetesApiCidrs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$"
          }
        },
        "dnsCidrs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$"
          }
        },
        "backendCidrs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$"
          }
        },
        "backendPorts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "egressPorts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "apiServer": {
          "type": "string",
          "pattern": "^https://[^/]+/?$"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "className",
        "sizeMi",
        "scratchSizeMi",
        "filesystem",
        "sqliteCompatible",
        "nodeLocal",
        "localRoot",
        "volumes"
      ],
      "properties": {
        "className": {
          "type": "string"
        },
        "sizeMi": {
          "type": "integer",
          "minimum": 1
        },
        "scratchSizeMi": {
          "type": "integer",
          "minimum": 1
        },
        "filesystem": {
          "enum": [
            "ext4",
            "xfs"
          ]
        },
        "sqliteCompatible": {
          "type": "boolean"
        },
        "nodeLocal": {
          "type": "boolean"
        },
        "localRoot": {
          "type": "string",
          "minLength": 2,
          "pattern": "^/[^.].*"
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "role",
              "path",
              "node",
              "sizeMi"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
              },
              "role": {
                "enum": [
                  "production",
                  "scratch",
                  "preflight"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "node": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
              },
              "sizeMi": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caBundle",
        "timeoutSeconds"
      ],
      "properties": {
        "caBundle": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+/=\\r\\n]+$"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "offline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "packageIndex",
        "extraPackageIndex",
        "npmRegistry",
        "packageEndpoints",
        "imageRepository",
        "imageRegistryEndpoints",
        "registrySecret",
        "insecureRegistry"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "packageIndex": {
          "type": "string"
        },
        "extraPackageIndex": {
          "type": "string"
        },
        "npmRegistry": {
          "type": "string"
        },
        "packageEndpoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imageRepository": {
          "type": "string"
        },
        "imageRegistryEndpoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "registrySecret": {
          "type": "string"
        },
        "insecureRegistry": {
          "type": "boolean"
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
