{
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "plugins": [
      {
        "name": "typescript-strict-plugin"
      }
    ],
    "useDefineForClassFields": true,
    "types": ["node", "jest", "@testing-library/jest-dom"],
    "paths": {
      "~/*": ["src/*"],
      "@/*": ["src/*"],
      "test/*": ["test/*"]
    }
  },
  "exclude": ["node_modules", "vite.config.ts"],
  "include": ["src", "test"]
}
