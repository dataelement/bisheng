        - market
        - share
      rows:
        - - 美国
          - 36.2
        - - 英国
          - 11.7
        - - 德国
          - 5.7
    series:
      - type: bar
        name: 出口目的地
        encode:
          x: share
          'y': market
        fill:
          type: solid
          color: $red
        dataLabels:
          show: false
    xAxis:
      min: 0
      max: 40
      label:
        fontSize: 9
        color: $gray
      gridLine:
        color: $grid
        style: dot
    yAxis:
      label:
        fontSize: 10
        color: $black
      gridLine: false
    legend:
      show: false
    fontFamily: &ref_0
      latin: Arial
      ea: Noto Sans CJK SC
      mac: PingFang SC
      win: Microsoft YaHei
    fill:
      type: solid
      color: '#FFFFFF00'
