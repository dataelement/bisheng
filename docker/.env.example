# Deployment variables for docker-compose.yml and the optional Compose files.
# Run `bash install.sh` to generate `.env` and deploy. The installer preserves
# existing settings. Defaults keep the legacy single-host credentials.
# Compose reads only `.env`; it does not load this template itself.
# Image addresses are defined here; Compose requires them from `.env`.
# Container-internal addresses and derived environment values are wired in
# docker-compose.yml.

# Images: use complete references, including registry/repository and tag or digest.
# Backend and worker share one image; OpenFGA and its migration share another.
BISHENG_BACKEND_IMAGE=cr.dataelem.com/dataelement/bisheng-backend:v3.0.0-test-compose-20261030-r3-amd64
BISHENG_FRONTEND_IMAGE=cr.dataelem.com/dataelement/bisheng-frontend:v3.0.0-test-compose-20261030-r3-amd64
MYSQL_IMAGE=cr.dataelem.com/mysql:8.0
OPENFGA_IMAGE=cr.dataelem.com/dataelement/openfga:v1.15.2-dm
REDIS_IMAGE=cr.dataelem.com/redis:7.0.4
ELASTICSEARCH_IMAGE=cr.dataelem.com/bitnami/elasticsearch:8.12.0
ETCD_IMAGE=cr.dataelem.com/quay.io/coreos/etcd:v3.5.5
MINIO_IMAGE=cr.dataelem.com/minio/minio:RELEASE.2023-03-20T20-16-18Z
MILVUS_IMAGE=cr.dataelem.com/milvusdb/milvus:v2.5.10
# Full image reference replaces the former SANDBOX_IMAGE_TAG setting.
BISHENG_SANDBOX_IMAGE=cr.dataelem.com/dataelement/bisheng-sandbox:feat_3.0.0
# Optional app-runtime profile images.
BISHENG_RUNTIME_MANAGER_IMAGE=cr.dataelem.com/dataelement/bisheng-runtime-manager:v3.0.0-test-compose-20261030-r3
BISHENG_APP_PROXY_IMAGE=cr.dataelem.com/dataelement/bisheng-app-proxy:v3.0.0-test-compose-20261030-r3
DOCKER_SOCKET_PROXY_IMAGE=cr.dataelem.com/tecnativa/docker-socket-proxy:0.3.0
# Optional standalone Compose services.
ONLYOFFICE_IMAGE=cr.dataelem.com/onlyoffice/documentserver:7.1.1
# Gateway v1.8.0 publishes separate architecture tags.
BISHENG_GATEWAY_IMAGE=cr.dataelem.com/dataelement/gateway:v1.8.0
# ARM alternative: set BISHENG_GATEWAY_IMAGE to cr.dataelem.com/dataelement/gateway:v1.8.0-arm64.

# The dedicated platform network is created automatically by Compose.
COMPOSE_PROJECT_NAME=bisheng
BISHENG_NETWORK_NAME=bisheng-network

# install.sh adds/removes gateway here; Compose uses this to select services.
COMPOSE_PROFILES=
BISHENG_PRO=false
BISHENG_PUBLIC_URL=
# User-supplied readable license file; no file means no Gateway.
BISHENG_GATEWAY_LICENSE_FILE=
# Populated from the file by install.sh, never entered directly.
BISHENG_GATEWAY_LICENSE=
BISHENG_GATEWAY_HMAC_SECRET=
BISHENG_GATEWAY_DB_PASSWORD=
# install.sh selects a generated directory when Gateway is enabled.
BISHENG_NGINX_CONF_DIR=./nginx/conf.d

# Required: object storage
# Object storage credentials. Used by MinIO itself, by the bisheng backend and
# workers, and by Milvus, which stores its segments in the same bucket. All of
# them must agree, so they are defined once here.
# Legacy defaults; retain your existing values when upgrading.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Base services
# Where the compose stack keeps its data directories. Defaults to the compose
# file's own directory.
DOCKER_VOLUME_DIRECTORY=.
# Maximum OpenFGA authorization graph resolution depth.
OPENFGA_RESOLVE_NODE_LIMIT=25

# Code sandbox
# Shared by backend, worker and both code runners. Replace the development
# token for deployment, e.g. with the output of openssl rand -hex 32.
SANDBOX_TOKEN=bisheng-sandbox-local
# Local code execution (code nodes, code interpreter type `local`) runs under a
# throwaway uid with resource limits. Startup tightens /app/bisheng and
# /app/data (host data/bisheng) to 0700. Set to `off` to keep the old
# same-user execution.
LOCAL_ISOLATION=uid

# CPUs shared by all sessions on each code runner (code-runner-1/2). Must be
# <= the host CPU count or Docker refuses to start the runners. Default 2.
SANDBOX_CPUS=2

# Optional app runtime: enable with --profile app-runtime and the matching
# backend configuration. See docs/architecture/14-app-factory-deployment.md
# and src/runtime-manager/OPERATIONS.md for the deployment prerequisites.
BISHENG_APP_DATA_ROOT=/opt/bisheng/app-data
BISHENG_RUNTIME_PROTOCOL_VERSION=2
BISHENG_RUNTIME_NODE_ID=docker-node-1
BISHENG_RUNTIME_OFFLINE=true
BISHENG_RUNTIME_IMAGE_PULL_POLICY=never
BISHENG_RUNTIME_TASK_TIMEOUT_SECONDS=1800
# Optional audit source DateTime zone; blank uses the backend/worker TZ (then UTC).
BISHENG_RUNTIME_AUDIT_SOURCE_TIMEZONE=

# App runtime authentication: generate a distinct secret for each variable,
# e.g. openssl rand -hex 32. Required when enabling the app-runtime profile.
# Keep real secrets out of Git and retain a secure backup.
BISHENG_RUNTIME_MANAGER_SECRET=
BISHENG_RUNTIME_CONTROL_SECRET=
BISHENG_RUNTIME_ENTRY_SECRET=
BISHENG_RUNTIME_EGRESS_SECRET=
BISHENG_APP_PROXY_HMAC_SECRET=
BISHENG_APP_OBO_SECRET=
# Fernet key, generated with cryptography. Shared by backend and worker only.
# Generate in the backend Python environment:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
BISHENG_RUNTIME_PAYLOAD_KEY=

# App runtime host isolation: independent Docker-host reporter identity.
# Generate the node descriptor with --describe and install host units before
# enabling app runtime; see deploy/runtime-manager/README.md.
BISHENG_RUNTIME_HOST_ISOLATION_SECRET=
BISHENG_RUNTIME_HOST_ISOLATION_NODES=

# App runtime capacity and build package indexes
BISHENG_RTM_RESERVE_MB=2048
BISHENG_RTM_OVERCOMMIT_RATIO=0.8
BISHENG_RTM_BUILD_RESERVE_MB=2048
# Optional approved Python/npm mirrors. Blank uses the runtime image defaults.
BISHENG_RTM_BUILD_INDEX_URL=
BISHENG_RTM_BUILD_NPM_REGISTRY=
# Runtime/preparer base images are selected by immutable profiles in backend,
# not by RTM_IMAGE_PREFIX. See src/runtime-manager/OPERATIONS.md.
