# 模板. 缺 env.sh 时脚本会自动生成, 不要手工 cp.
# 跑 full-migrate / 回滚会问 A 的地址并写进生成后的 env.sh; 密码只留当前窗口.
# 优先级: 会话里已 export 的变量 > 本文件 ${VAR:-} 默认 > 脚本默认.
# 不要把密码/私钥提交到 git.
# shellcheck disable=SC2034

export PACK_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export LEDGER="${PACK_ROOT}/logs/ledger.tsv"
export LOG_DIR="${PACK_ROOT}/logs"

# --- 目标构建（D02）---
# 演练不用改: 预检看到不是 40 位 sha 就跳过钉扎, 不必 export DRILL=1.
# 生产必须改成 40 位小写 sha.
# 2.5 hop 的 backend/frontend 以压缩包 docker-compose.yml 为准, 不要靠下面两项去覆盖.
export TARGET_GIT_COMMIT="${TARGET_GIT_COMMIT:-DRILL-SKIP}"
export TARGET_BACKEND_IMAGE="registry.example.com/bisheng-backend-shougang@sha256:REPLACE"
export TARGET_FRONTEND_IMAGE="registry.example.com/bisheng-frontend-shougang@sha256:REPLACE"
# 2.3/2.4 hop 仍用下面 IMAGE_2_* ; 2.5 升完后以镜像 alembic head 为准, 不写死 f058.
export TARGET_ALEMBIC_HEAD="f058_dashboard_dataset_flags"

# hop 工具镜像（官方 Docker Hub；内网请改成已同步且带 digest 的副本）
export IMAGE_2_3_BETA1="dataelement/bisheng-backend:v2.3.0-beta1"
export IMAGE_2_3="dataelement/bisheng-backend:v2.3.0"
export IMAGE_2_4_BETA1="dataelement/bisheng-backend:v2.4.0-beta1"
export IMAGE_2_4="dataelement/bisheng-backend:v2.4.0"
export IMAGE_FRONTEND_2_3_BETA1="dataelement/bisheng-frontend:v2.3.0-beta1"
export IMAGE_FRONTEND_2_3="dataelement/bisheng-frontend:v2.3.0"
export IMAGE_FRONTEND_2_4_BETA1="dataelement/bisheng-frontend:v2.4.0-beta1"
export IMAGE_FRONTEND_2_4="dataelement/bisheng-frontend:v2.4.0"

# OpenFGA：2.5 hop 不读这个变量, 以压缩包 docker-compose.yml 的 openfga image 为准.
export IMAGE_OPENFGA="REPLACE_WITH_PINNED_OPENFGA_DIGEST"

# --- 部署布局 ---
# 正常不用填：脚本会从运行中的容器标签反查 compose 文件列表、project 名和
# project directory（见 lib/discover.sh）。只有自动发现失败时才显式指定。
# 注意 compose 里的数据卷写成 ${DOCKER_VOLUME_DIRECTORY:-.}/xxx，按 project
# directory 解析；手工指定错了会把数据卷指到空目录，且全程不报错。
# export COMPOSE_FILE="/path/to/docker-compose.yml"
# export COMPOSE_PROJECT="docker"
# export COMPOSE_WORKDIR="/path/to"

# 压缩包里 docker/ 的位置。整仓解压后一般能自动找到，找不到再填。
# export PACK_DOCKER_DIR="/data/bisheng/docker"

# 容器名与默认值不同时才需要改。
export BACKEND_CONTAINER="bisheng-backend"
export WORKER_CONTAINER="bisheng-backend-worker"
export FRONTEND_CONTAINER="bisheng-frontend"
export MYSQL_CONTAINER="bisheng-mysql"
export MYSQL_DB="bisheng"

# 走 docker exec 进 mysql 容器时用容器内 root；不要把密码写进本文件入库。
# 推荐：export MYSQL_PWD 仅在执行会话里，或依赖容器环境 MYSQL_ROOT_PASSWORD
export MYSQL_USER="root"

# --- 备份目录（要有足够空间：MySQL+MinIO+Milvus+ES）---
export BACKUP_DIR="/data/upgrade-backups"
# 冻结负责人, 写入 MANIFEST
# export BACKUP_OPERATOR=""
# hop 认 logs/p2/current-freeze.txt; 也可 export BACKUP_STAMP="20260911124114"
# 已升完的本轮演练机若必须重跑 hop (禁止用于新环境): SKIP_P2_FREEZE_GATE=1
# 完整恢复对象存储: CONFIRM_RESTORE_STORAGE=1
# APPLY=1 时: CONFIRM_VERSION_ROLLBACK ; 不完整冻结还要 ACCEPT_INCOMPLETE_STORAGE

# --- 门禁 ---
# P2 hop 跑起来就升级，不用 APPLY / CONFIRM_LAYOUT。
# P4/P5 默认不落库，确认后再设 1。
export APPLY="${APPLY:-0}"
# 批次名脚本自取 (fusion-当天日期), 写到 logs/current-batch.txt 并打印.
# 同一台机器同时跑两车搬家才需要: export BATCH_NO=fusion-自定义
# type=2 转换需与 D07 一致后再设 1
export CONFIRM_TYPE2="${CONFIRM_TYPE2:-0}"
# F006 execute 前必须先成功 dry_run
export CONFIRM_F006="${CONFIRM_F006:-0}"

# 多租户：本窗口保持关闭（评审 D13 共享存储解耦）
export EXPECT_MULTI_TENANT="false"
# 一般不用设. 没填 40 位 sha 时预检自动跳过钉扎.
# 已填 sha 仍要跳过镜像校验时才: export DRILL=1
export DRILL="${DRILL:-0}"

# --- B→A 融合 (在 B 上跑, A 走 SSH) ---
# 必填, 无脚本默认 IP. 会话里已 export 的不会被覆盖.
# 本轮演练曾用: USER=Oper1 HOST=10.171.0.50 PORT=52012 ; 生产另填.
export A_SSH_USER="${A_SSH_USER:-}"
export A_SSH_HOST="${A_SSH_HOST:-}"
export A_SSH_PORT="${A_SSH_PORT:-}"
# auto=密钥优先, 有 SSHPASS 则可回退密码. 本轮演练先密码: password
export A_SSH_AUTH="${A_SSH_AUTH:-password}"
# export A_SSH_KEY="/root/.ssh/id_rsa"
# 密码用会话 SSHPASS, 不要写进本文件. 跑 full-migrate.sh 时会问, 只留在当前窗口.
# 仅 password/auto 且走密码时才需要 sshpass.
export A_MYSQL_CONTAINER="bisheng-mysql"
export A_MYSQL_DB="bisheng"
export MIGRATE_B_SPACES="${MIGRATE_B_SPACES:-0}"
export CONFIRM_A_SHARED_SPACE="${CONFIRM_A_SHARED_SPACE:-0}"
# 积分不迁. 审计默认迁, 无需开关
export CONFIRM_POINTS="${CONFIRM_POINTS:-0}"
export CONFIRM_FULL_MIGRATE="${CONFIRM_FULL_MIGRATE:-0}"
# 仅 MySQL+compose 退 2.4. 见 p2/90-rollback.sh
export CONFIRM_VERSION_ROLLBACK="${CONFIRM_VERSION_ROLLBACK:-0}"
export ACCEPT_INCOMPLETE_STORAGE="${ACCEPT_INCOMPLETE_STORAGE:-0}"
export CONFIRM_RESTORE_STORAGE="${CONFIRM_RESTORE_STORAGE:-0}"
# 检索金标 overlap@k 下限; 不达标仍要看报告时 GOLD_ALLOW_FAIL=1
export GOLD_MIN_HIT=0.8
# 迁入工作流/助手改 status=2. APPLY=1 还要本开关
export CONFIRM_PUBLISH_FLOWS="${CONFIRM_PUBLISH_FLOWS:-0}"
# MinIO / OpenFGA. 容器名与现场不一致时再填; 不要把密钥写进本文件.
# export B_MINIO_CONTAINER="bisheng-minio"
# export A_MINIO_CONTAINER="bisheng-minio"
export B_MINIO_BUCKET="bisheng"
export A_MINIO_BUCKET="bisheng"
export A_OPENFGA_URL="http://127.0.0.1:8080"
export B_OPENFGA_URL="http://127.0.0.1:8080"
export OPENFGA_STORE_NAME="bisheng"
# Milvus/ES 走 backend 容器内的 BS_MILVUS_CONNECTION_ARGS / BS_ELASTICSEARCH_URL. 容器名不同再填.
# export BACKEND_CONTAINER="bisheng-backend"
# export A_BACKEND_CONTAINER="bisheng-backend"
